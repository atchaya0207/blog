<%- include("partials/header") %>

<main>
  <div style="max-width:700px; margin: 40px auto;">
    
    <div style="background:white; padding:30px; border-radius:10px; box-shadow:0 4px 15px rgba(0,0,0,0.1); margin-bottom:30px; text-align:center;">
      <div style="width:70px; height:70px; background:#021c43; border-radius:50%; margin:0 auto 16px; display:flex; align-items:center; justify-content:center;">
        <span style="color:white; font-size:28px;">👤</span>
      </div>
      <h2 style="color:#021c43; margin:0;"><%= username %></h2>
      <p style="color:#888; margin-top:8px;"><%= posts.length %> post<%= posts.length !== 1 ? 's' : '' %> published</p>
      <a href="/" style="color:#3498db;">← Back to all posts</a>
    </div>

    <h3 style="color:#021c43;">My Posts</h3>

    <% if (posts.length === 0) { %>
      <div style="background:white; padding:20px; border-radius:8px; text-align:center; color:#888;">
        You haven't written any posts yet. <a href="/" style="color:#3498db;">Start writing!</a>
      </div>
    <% } else { %>
      <% posts.forEach(post => { %>
        <div class="post">
          <h2><%= post.title %></h2>
          <p><%= post.content %></p>
          <small style="color:#888;"><%= new Date(post.createdAt).toDateString() %></small>
          <div style="margin-top:10px;">
            <form action="/edit/<%= post._id %>" method="get" style="display:inline;">
              <button>Edit</button>
            </form>
            <form action="/delete/<%= post._id %>" method="post" style="display:inline;">
              <button style="background-color:#e74c3c;">Delete</button>
            </form>
          </div>
        </div>
        <hr />
      <% }) %>
    <% } %>
  </div>
</main>

<%- include("partials/footer") %>